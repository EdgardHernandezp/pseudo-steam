{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::{bucket-name}",
        "arn:aws:s3:::{bucket-name}/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:DataAccessPointAccount": "442599936326"
        }
      }
    }
  ]
}